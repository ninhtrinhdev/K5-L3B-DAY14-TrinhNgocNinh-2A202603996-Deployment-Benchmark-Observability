# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bảo mật — đặt key thật trên nền tảng deploy, không commit
AGENT_API_KEY=change-me

# Redis (docker-compose tự đặt redis://redis:6379/0 cho service agent)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
